generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"

    runtime             = "nodejs"
    importFileExtension = "ts"

    previewFeatures = ["relationJoins"]
}

datasource db {
    provider = "postgresql"
}

model Example {
    id        String   @id @db.VarChar(24)
    title     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
